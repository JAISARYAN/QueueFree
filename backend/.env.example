# ==============================================================================
# QueueFree Backend Environment Configuration Template
# Copy this file to .env and configure values appropriate for your environment.
# NEVER commit actual secrets, passwords, or keys to version control.
# ==============================================================================

# Core Application Settings
DEBUG=True
SECRET_KEY=django-insecure-replace-this-with-a-secure-random-key-in-production-min-50-chars
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=queuefree_db
DB_USER=postgres
DB_PASSWORD=your_secure_postgres_password_here
DB_HOST=localhost
DB_PORT=5432

# CORS Configuration (Comma-separated list of allowed frontend origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Future Real-Time / Cache Configuration (Phase 5)
REDIS_URL=redis://localhost:6379/0

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
